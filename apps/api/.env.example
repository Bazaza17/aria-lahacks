# Copy to .env and fill in. Never commit real values.

# Required for live agent runs (POST /agent/run)
ANTHROPIC_API_KEY=

# Supabase — used to cache agent runs for replay. Optional: without these,
# live runs still work and /agent/replay returns 503.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Extra allowed CORS origins, comma-separated (localhost:3000 and
# *.vercel.app are always allowed)
ALLOWED_ORIGINS=


# Only needed by scripts/prewarm_cache.py (defaults to http://localhost:8000)
ARIA_API_URL=
