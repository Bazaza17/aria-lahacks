# Copy to .env and fill in. Never commit real values.

# Extra allowed CORS origins, comma-separated (localhost:3000 and
# *.vercel.app are always allowed)
ALLOWED_ORIGINS=

# Sentry, Python project (the API and the engine). Tag events by environment:
# laptop or cloud. On Railway use cloud: a missing key is then an error, never open.
SENTRY_DSN=
SENTRY_ENVIRONMENT=laptop

# ---- CREAO layer: live incidents, exit tracking, the CREAO command staff (docs/creao-layer.md)
# TigerData (or any Postgres): postgresql+asyncpg://user:pass@host:port/db. Empty = a local SQLite file.
CREAO_DATABASE_URL=
CREAO_DEFAULT_BUILDING_ID=547b5ec5-30c5-4f76-8080-012a52e90bd9
# This API's public URL (CREAO calls back to it)
PUBLIC_BASE_URL=
# Sai's Photon + ElevenLabs pipeline and the ElevenLabs server tools send this as X-Tool-Secret
CREAO_TOOL_SECRET=
# Dispatcher dashboard keys (Authorization: Bearer), comma-separated
DISPATCH_API_KEYS=
# Keyless drills from the public console (they text and call real phones). Off unless 1.
PUBLIC_DRILLS=
# CREAO custom MCP connector token(s), comma-separated
MCP_API_KEYS=
# CREAO command staff: one CREAO key (capi_...) plus each agent's app id (the id in its install link)
CREAO_API_KEY=
CREAO_APP_COMMANDER=ef349685-a692-4a0d-ae20-eb2e1f524624
CREAO_APP_INTAKE=113efaf2-fd95-4ca2-9e84-3f3481309423
CREAO_APP_COORDINATOR=e433f077-c48d-4080-8d6f-4ff771633c06
CREAO_APP_ACCOUNTABILITY=2d6f125c-13a4-4872-a54d-0471491485f8
CREAO_APP_LIAISON=20ca703a-c164-48af-8752-69887706dd04
CREAO_APP_SCRIBE=db6d854b-42ed-4df9-be21-90131c53ec3e
CREAO_WEBHOOK_TOKEN=
CREAO_DEBOUNCE_SECS=15
# "Join call" hands the caller to this number (E.164)
DISPATCHER_PHONE=
