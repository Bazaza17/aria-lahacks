# Photon 2.0 (https://app.photon.codes): project id + project API key
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# ElevenLabs: API key with Agents access. AGENT_ID is written by `npm run agent:sync`.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The Photon voice number imported into ElevenLabs (phnum_...). Needed for CALL.
ELEVENLABS_PHONE_NUMBER_ID=

PORT=8787
