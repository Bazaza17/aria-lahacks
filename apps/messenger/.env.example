# Photon 2.0 (https://app.photon.codes): project id + project API key
PHOTON_PROJECT_ID=
PHOTON_API_KEY=

# ElevenLabs: API key with Agents access. AGENT_ID is written by `npm run agent:sync`.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The Photon voice number imported into ElevenLabs (phnum_...). Needed for CALL.
ELEVENLABS_PHONE_NUMBER_ID=

PORT=8787

# Optional: Aria's live incident layer (apps/api /live, TigerData + the CREAO staff). Empty = off.
# The API's URL, and the API's CREAO_TOOL_SECRET (ask Aayush; never commit it).
ARIA_LIVE_URL=
ARIA_TOOL_SECRET=
ARIA_BUILDING_ID=547b5ec5-30c5-4f76-8080-012a52e90bd9
# The API's public URL as ElevenLabs reaches it (deployed API or a tunnel). `npm run agent:sync`
# points the agent's update_aria webhook here, for live mid-call updates. Re-sync if it changes.
ARIA_PUBLIC_URL=

# Local testing only: point the Photon client at a fake Photon. Leave empty for the real API.
PHOTON_BASE_URL=

# Calls: the human dispatcher ElevenLabs transfers a call to on a trigger word ("trapped",
# "can't breathe"...). Pushed into the agent by `npm run agent:sync`.
DISPATCHER_PHONE=
# Testing only: point at a local fake ElevenLabs instead of api.elevenlabs.io.
# ELEVENLABS_BASE_URL=http://localhost:8800
# How often a call's transcript is polled and forwarded to Aria (ms).
# ARIA_CALL_POLL_MS=10000
