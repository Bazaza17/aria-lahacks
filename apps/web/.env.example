# Copy to .env.local and fill in. Never commit real values.
# All NEXT_PUBLIC_* values are embedded in the browser bundle — only put
# public (anon / publishable) keys here.

# FastAPI backend (apps/api). Local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project (Project Settings → API). Anon key only, never service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox public token (pk.*) for the /dashboard map
NEXT_PUBLIC_MAPBOX_TOKEN=

# Sentry, Next.js project. The DSN is public; tag events by environment.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=laptop
