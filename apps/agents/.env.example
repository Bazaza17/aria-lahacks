# Copy to .env and fill in. Never commit .env.

# Any long random string. It fixes the agent's address, so keep it secret
# and don't change it once the agent is registered on Agentverse.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
HELLO_AGENT_SEED=

# Sentry, Python project (shared by the API, agents and engine). Tag events by
# environment: laptop or cloud.
SENTRY_DSN=
SENTRY_ENVIRONMENT=laptop
